cat > .gitignore << 'EOF'
# Ignore all dotfiles/dotfolders by default
.*

# Explicit exceptions — these MUST stay tracked
!.gitignore
!.env.example

# Data (all generated artifacts, reconstructed by pipeline.sh)
data/

# Office lock files
~$*

# Python bytecode
__pycache__/
*.pyc
*.pyo
EOF

~$presentation_puls_events_EN (2).pptx
~$presentation_puls_events_EN.pptx
~$presentation_puls_events_FR.pptx